; A ring belongs to an engine and an engine to a domain. Checks the mixed
; process: one domain on io_uring, another on the default engine. Needs a second
; domain, hence OCaml 5.

(test
 (name domain_rings)
 (package lwt_uring)
 (modules domain_rings)
 (enabled_if
  (= %{system} linux))
 (build_if
  (>= %{ocaml_version} "5.0"))
 (libraries lwt.unix lwt_uring unix))

(test
 (name test_lwt_uring)
 (package lwt_uring)
 (modules test_lwt_uring)
 (enabled_if
  (= %{system} linux))
 (libraries lwt.unix lwt_uring unix))

; Run Lwt's existing test/unix suites with the io_uring engine installed.

(copy_files
 (files %{project_root}/test/unix/bytes_io_data))

(test
 (name main_uring)
 (package lwt_uring)
 (modules main_uring)
 (enabled_if
  (= %{system} linux))
 (deps bytes_io_data)
 (libraries lwttester tester lwt_uring))

; The benchmarks below are self-contained: each measures the default engine
; and then io_uring in one process. They are declared as tests of the package
; so that a build restricted to other packages (the CI, a switch without
; uring) leaves them alone, and so that [dune runtest] exercises each
; io_uring path once, at a cost of a few seconds.

; Micro-benchmark: socketpair ping-pong under the default vs io_uring engine.

(test
 (name bench_pingpong)
 (package lwt_uring)
 (modules bench_pingpong)
 (enabled_if
  (= %{system} linux))
 (libraries lwt.unix lwt_uring unix))

; Request/response server benchmark over Lwt_io (the cohttp I/O path).

(test
 (name bench_server)
 (package lwt_uring)
 (modules bench_server)
 (enabled_if
  (= %{system} linux))
 (libraries lwt.unix lwt_uring unix))

; New-connection benchmark: isolates routing accept/connect through io_uring.

(test
 (name bench_connect)
 (package lwt_uring)
 (modules bench_connect)
 (enabled_if
  (= %{system} linux))
 (libraries lwt.unix lwt_uring unix))
