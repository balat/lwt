; A model of the bounded channel, checked by qcheck-stm. Sequential: blocking
; operations are not linearisable against a deterministic model, so concurrency is
; tested by forced interleaving elsewhere.

(test
 (name stm_stream)
 (package lwt_multicore)
 (modules stm_stream)
 (build_if
  (>= %{ocaml_version} "5.0"))
 (libraries lwt.unix lwt_multicore qcheck-stm.sequential))

; An exit hook that waits for another domain: the process must exit.

(test
 (name exit_hooks)
 (package lwt_multicore)
 (modules exit_hooks)
 (build_if
  (>= %{ocaml_version} "5.0"))
 (libraries lwt.unix lwt_multicore))

; Work posted to a loop that leaves before running it: a lock comes back, an
; adoption is rejected.

(test
 (name departed_loop)
 (package lwt_multicore)
 (modules departed_loop)
 (build_if
  (>= %{ocaml_version} "5.0"))
 (libraries lwt.unix lwt_multicore))

