; The shared value is linearisable across real domains, checked by qcheck-lin.

(test
 (name lin_shared_value)
 (package lwt_multicore)
 (modules lin_shared_value)
 (build_if
  (>= %{ocaml_version} "5.0"))
 (libraries lwt_multicore qcheck-lin.domain))

; Lwt_unix notifications across domains and threads: the table of notifiers is
; linearisable (qcheck-lin), and every send is delivered exactly once (QCheck).

(test
 (name notifications)
 (package lwt_multicore)
 (modules notifications)
 (build_if
  (>= %{ocaml_version} "5.0"))
 (libraries lwt.unix threads.posix qcheck-lin.domain))

; Semaphore, Mutex and Stream on two real domains at once, against models
; (qcheck-stm, parallel).

(test
 (name stm_domain_sync)
 (package lwt_multicore)
 (modules stm_domain_sync)
 (build_if
  (>= %{ocaml_version} "5.0"))
 (libraries lwt.unix lwt_multicore qcheck-stm.domain))

; A waiter served by another domain and cancelled by its own before its loop
; runs: what it was given comes back at once, and only once.

(test
 (name handover)
 (package lwt_multicore)
 (modules handover)
 (build_if
  (>= %{ocaml_version} "5.0"))
 (libraries lwt.unix lwt_multicore))

; A producer waiting for room keeps its turn: the room freed for it is reserved
; until it retries, and a later producer waits behind it.

(test
 (name stream_order)
 (package lwt_multicore)
 (modules stream_order)
 (build_if
  (>= %{ocaml_version} "5.0"))
 (libraries lwt.unix lwt_multicore))
