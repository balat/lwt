(library
 (name tester)
 (libraries lwt lwttester)
 (modules
  (:standard
   \
   main
   dummy
   ocaml_runtime_exc_1
   ocaml_runtime_exc_2
   ocaml_runtime_exc_3
   ocaml_runtime_exc_4
   ocaml_runtime_exc_5
   ocaml_runtime_exc_6
   set_engine
   domain_exit_hooks
   domain_engines
   domain_channels
   domain_unix_policy
   domain_timeouts
   domain_io_affinity
   domain_two_loops)))

; S2's exit criterion: two domains running their own Lwt_main.run at the same
; time, each with real socket I/O and timers. Needs a second domain, hence
; OCaml 5.

(test
 (name domain_two_loops)
 (package lwt)
 (modules domain_two_loops)
 (build_if
  (>= %{ocaml_version} "5.0"))
 (libraries lwt.unix))

; Descriptors and channels belong to the domain that created them, including on
; the single-character fast paths. Needs a second domain, hence OCaml 5.

(test
 (name domain_io_affinity)
 (package lwt)
 (modules domain_io_affinity)
 (build_if
  (>= %{ocaml_version} "5.0"))
 (libraries lwt.unix))

; Each domain runs its own timer wheel, while the preemptive thread pool stays
; shared and detaching belongs to the notification owner. Needs a second domain,
; hence OCaml 5.

(test
 (name domain_timeouts)
 (package lwt)
 (modules domain_timeouts)
 (build_if
  (>= %{ocaml_version} "5.0"))
 (libraries lwt.unix))

; Jobs, signals and child waiting go through the process-wide notification file
; descriptor, so they belong to the domain that initialised Lwt_unix. Needs a
; second domain, hence OCaml 5.

(test
 (name domain_unix_policy)
 (package lwt)
 (modules domain_unix_policy)
 (build_if
  (>= %{ocaml_version} "5.0"))
 (libraries lwt.unix))

; The table of open output channels is per domain: [flush_all] flushes the
; calling domain's channels, and each domain flushes its own when it ends. Needs
; a second domain, hence OCaml 5.

(test
 (name domain_channels)
 (package lwt)
 (modules domain_channels)
 (build_if
  (>= %{ocaml_version} "5.0"))
 (libraries lwt.unix))

; An event source belongs to a loop: each domain gets its own engine. Needs a
; second domain, hence OCaml 5.

(test
 (name domain_engines)
 (package lwt)
 (modules domain_engines)
 (build_if
  (>= %{ocaml_version} "5.0"))
 (libraries lwt.unix))

; Exit hooks belong to a loop, so they must run on the domain that registered
; them. Needs a second domain, hence OCaml 5.

(test
 (name domain_exit_hooks)
 (package lwt)
 (modules domain_exit_hooks)
 (build_if
  (>= %{ocaml_version} "5.0"))
 (libraries lwt.unix))

