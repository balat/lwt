  lwt_mutex
  lwt_condition
  lwt_seq
  lwt_stream
  lwt_react
  test_lwt_event
  test_lwt_signal)
 (enabled_if
  (>= %{ocaml_version} "5.0"))
 (flags
  (:standard -alert -all))
 (libraries candidate_lwt lwt_effects lwt react unix))
