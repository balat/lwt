; Behavioral oracle, react leg: run the unchanged lwt_react suites against the
; effect-backed candidate. Reactive programming is a key use case for keeping
; the monadic typing, so lwt_react (recompiled against the candidate, with its
; Lwt_stream/Lwt_mutex dependencies) running Lwt's own suites is a strong
; conformance signal. Same textual-prelude technique as ../run and ../ppx.

(rule
 (with-stdout-to
  test.ml
  (progn
   (cat %{dep:../run/test_prelude.in})
   (cat %{dep:../../test.ml}))))

; Auxiliary core modules lwt_react and the suites need.

(rule
 (with-stdout-to
  lwt_list.ml
  (progn
   (echo "module Lwt = Candidate_lwt\n")
   (cat %{dep:../../../src/core/lwt_list.ml}))))

(rule
 (with-stdout-to
  lwt_list.mli
  (progn
   (echo "module Lwt = Candidate_lwt\n")
