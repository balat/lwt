(* Prelude prepended to test/test.ml (the tester) so that it drives the
   effect-backed candidate instead of the real Lwt:
   - [Lwt] is the candidate (constrained by the unchanged lwt.mli);
   - [Lwt_main.run] bridges to the effect scheduler through the candidate's
     PUBLIC API only ([on_any]) — promise machinery and scheduler are the same
     global lwt_effects instance, so resolving [p] wakes the bridge.
   [Lwt_list] is the vendored auxiliary module (recompiled against the
   candidate), resolved from the executable's own modules. *)

module Lwt = Candidate_lwt

module Lwt_main = struct
  let run p =
    Lwt_effects.run (fun () ->
      let q, r = Lwt_effects.wait () in
      Candidate_lwt.on_any p
        (fun v -> Lwt_effects.wakeup r v)
        (fun e -> Lwt_effects.wakeup_exn r e);
      q)
end
