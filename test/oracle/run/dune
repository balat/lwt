; Behavioral oracle for B2b: run Lwt's own core test suite (test/core/*,
; unchanged) against the effect-backed candidate Lwt.
;
; The tester (test/test.ml), the auxiliary core modules (src/core/lwt_*.ml,
; written purely against Lwt's public API) and the test suites are vendored
; TEXTUALLY by prepending a [module Lwt = Candidate_lwt] alias (see
; test_prelude.in for the tester: plus a minimal [Lwt_main.run] driving the
; effect scheduler and the two Lwt_list functions the tester uses), so the very
; same sources exercise the candidate. The pass/fail score is the
; behavioural-conformance score of the core swap. [Lwt_sequence] is pure (no
; Lwt dependency) and is used directly from the real lwt library.

(rule
 (with-stdout-to
  test.ml
  (progn
   (cat %{dep:test_prelude.in})
   (cat %{dep:../../test.ml}))))

; Auxiliary core modules, recompiled against the candidate.

(rule
 (with-stdout-to
  lwt_list.ml
  (progn
   (echo "module Lwt = Candidate_lwt\n")
   (cat %{dep:../../../src/core/lwt_list.ml}))))

(rule
 (with-stdout-to
  lwt_list.mli
  (progn
   (echo "module Lwt = Candidate_lwt\n")
