; Behavioral oracle, ppx leg: run the unchanged lwt_ppx suite (test/ppx/main.ml)
; against the effect-backed candidate. The ppx expands to Lwt.backtrace_bind,
; Lwt.catch, Lwt_main.run (structure-level let%lwt), ... — all resolved to the
; candidate through the same textual [module Lwt = Candidate_lwt] prelude and
; the vendored tester (whose Test.Lwt_main bridges the effect scheduler).

(rule
 (with-stdout-to
  test.ml
  (progn
   (cat %{dep:../run/test_prelude.in})
   (cat %{dep:../../test.ml}))))

(rule
 (with-stdout-to
  oracle_ppx_main.ml
  (progn
   (cat %{dep:../sleep_prelude.in})
   (cat %{dep:../../ppx/main.ml}))))

; The tester uses Lwt_list: vendor it against the candidate (as in ../run),
; lest it resolve to the real lwt library's and mix the two promise types.

(rule
 (with-stdout-to
  lwt_list.ml
  (progn
   (echo "module Lwt = Candidate_lwt\n")
   (cat %{dep:../../../src/core/lwt_list.ml}))))

(rule
 (with-stdout-to
  lwt_list.mli
  (progn
   (echo "module Lwt = Candidate_lwt\n")
   (cat %{dep:../../../src/core/lwt_list.mli}))))

(executable
 (name oracle_ppx_main)
 (modules oracle_ppx_main test lwt_list)
 (enabled_if
  (>= %{ocaml_version} "5.0"))
 (flags
  (:standard -alert -all))
 (preprocess
  (pps lwt_ppx))
 (libraries candidate_lwt lwt_effects lwt lwt.unix unix))
