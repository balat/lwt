(* Prelude prepended to test/ppx/main.ml: [Lwt] is the candidate, and the one
   Lwt_unix function the suite uses ([sleep]) is the effect core's timer,
   bridged to a candidate promise through the candidate's PUBLIC API (same
   technique as the tester's Lwt_main.run bridge, in the other direction). *)

module Lwt = Candidate_lwt

module Lwt_unix = struct
  let sleep d =
    let p, r = Lwt.task () in
    let s = Lwt_effects.sleep d in
    Lwt_effects.on_any s
      (fun () -> Lwt.wakeup r ())
      (fun e -> Lwt.wakeup_exn r e);
    p
end
