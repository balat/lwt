; Separate, optional, Linux-only package (like eio_linux): it depends on uring,
; so it is kept out of the portable lwt_effects package. On non-Linux systems the
; uring dependency is unavailable, so the package simply does not install there.

(library
 (name lwt_effects_uring)
 (public_name lwt_effects_uring)
 (synopsis
  "io_uring back end for the Lwt_effects scheduler (POC, Linux only)")
 (enabled_if
  (and
   (>= %{ocaml_version} "5.3")
   (= %{system} linux)))
 (libraries lwt_effects uring cstruct optint unix))
